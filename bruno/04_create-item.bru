meta {
  name: Create Item
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/items
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Water filter",
    "color": "Blue",
    "cadence_days": 90,
    "next_maintenance_notes": "Need a 3rd-party filter, not OEM",
    "tags": ["Kitchen", "filters"]
  }
}

vars:post-response {
  itemId: res.body.id
}
