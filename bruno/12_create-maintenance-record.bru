meta {
  name: Create Maintenance Record
  type: http
  seq: 12
}

post {
  url: {{base_url}}/api/items/{{itemId}}/maintenance_records
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "date": "2026-08-15",
    "summary": "Replaced filter cartridge",
    "cost": 45.00,
    "contractor_info": "DIY"
  }
}

vars:post-response {
  recordId: res.body.id
}
