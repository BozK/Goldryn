# Local development: copy to .env in the repo root and fill in.
# Server (Docker): copy to /srv/goldryn/.env, next to the repo rather than inside it. See DEPLOY.md.
#
# Generate the hash with:
#   .venv/Scripts/python backend/hash_password.py
# or, on the server:
#   docker compose run --rm goldryn python backend/hash_password.py

# Server (Docker) only: UID/GID of the goldryn system user (from: id goldryn).
# The container runs as this user. compose.yaml refuses to start without them.
APP_UID=
APP_GID=

GOLDRYN_USERNAME=
# Keep the single quotes: bcrypt hashes contain "$". python-dotenv and docker
# compose both read single-quoted values literally.
GOLDRYN_PASSWORD_HASH=''

# Local development only. The session cookie is Secure by default, which browsers
# won't send over plain http. Uncomment for http://127.0.0.1; leave it out on the server.
# GOLDRYN_COOKIE_SECURE=false

# Server (Docker) only. The image defaults to America/New_York; uncomment to change it.
# Don't set TZ on Windows: Python there misreads names like this and gets local time wrong.
# TZ=America/New_York
