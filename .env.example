# Copy to .env and fill in. Generate the hash with:
#   .venv/Scripts/python backend/hash_password.py
GOLDRYN_USERNAME=
# Keep the single quotes: bcrypt hashes contain "$".
GOLDRYN_PASSWORD_HASH=''

# Optional. Defaults to data/goldryn.db in the repo root.
# GOLDRYN_DB_PATH=

# The session cookie is Secure by default, which browsers won't send over plain
# http. Set to false for local development on http://127.0.0.1.
GOLDRYN_COOKIE_SECURE=false
